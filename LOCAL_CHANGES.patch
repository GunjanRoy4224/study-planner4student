+        r"(?:bearer\s+[a-zA-Z0-9_\-\.]{10,}|sk-[a-zA-Z0-9_\-]{20,}|gh[pousr]_[a-zA-Z0-9_]{20,}|xox[baprs]-[a-zA-Z0-9\-]+|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]+PRIVATE KEY-----)",
+        re.IGNORECASE,
+    )
+
+    if isinstance(payload, dict):
+        clean = {}
+        for k, v in payload.items():
+            k_str = str(k)
+            k_lower = k_str.lower()
+            if sensitive_re.search(k_str):
+                clean[k_str] = "[REDACTED]"
+            elif action_type in ("browser_type", "type") and k_lower in ("text", "content", "element_text"):
+                clean[k_str] = "[REDACTED INPUT]"
+            elif k_lower in ("content", "diff", "patch") and isinstance(v, str) and len(v) > 200:
+                v_clean = secret_value_re.sub("[REDACTED SECRET]", v)
