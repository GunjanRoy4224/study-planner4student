+    """Parse host and port from authority target, supporting IPv6 literals like [::1]:443."""
+    target = target.strip()
+    if target.startswith("["):
+        bracket_end = target.find("]")
+        if bracket_end != -1:
+            host = target[1:bracket_end]
+            port_part = target[bracket_end + 1 :]
+            if port_part.startswith(":"):
+                port_s = port_part[1:]
+                port = int(port_s) if port_s.isdigit() else default_port
+            else:
+                port = default_port
+            return host, port
+    if ":" in target:
+        host, _, port_s = target.rpartition(":")
+        port = int(port_s) if port_s.isdigit() else default_port
+        return host, port
+    return target, default_port
