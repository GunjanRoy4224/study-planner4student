+def authenticate_principal(request: Request) -> str:
+    """Authenticate the principal for approval operations.
+
+    Security rules:
+    - Never accept unauthenticated callers.
+    - If OPENJARVIS_API_KEY or app.state.api_key is set, validate Bearer token.
+    - Never treat an arbitrary Bearer token as valid without verification.
+    - Never infer identity from an arbitrary HTTP header (e.g. X-User-Id without auth).
+    - An empty principal or unauthenticated fallback ("user") is explicitly rejected.
+    """
+    if request is None:
+        raise HTTPException(status_code=401, detail="Authentication required: request missing")
+
+    app_state = getattr(getattr(request, "app", None), "state", None)
+    expected_key = getattr(app_state, "api_key", "") if app_state else ""
+    if not isinstance(expected_key, str) or not expected_key:
+        expected_key = os.environ.get("OPENJARVIS_API_KEY", "")
+    if not isinstance(expected_key, str):
+        expected_key = str(expected_key or "")
+
+    auth_header = request.headers.get("Authorization", "").strip()
+    user_header = (
+        request.headers.get("X-OpenJarvis-Principal", "").strip()
+        or request.headers.get("X-User-Id", "").strip()
+    )
+
+    # 1. When an API key is configured on server, Bearer token is strictly verified
+    if expected_key:
+        if not auth_header:
+            raise HTTPException(status_code=401, detail="Authentication required: missing Authorization header")
+        scheme, _, token = auth_header.partition(" ")
+        if scheme.lower() != "bearer" or not token or not secrets.compare_digest(
+            token.encode("utf-8"), expected_key.encode("utf-8")
+        ):
+            raise HTTPException(status_code=401, detail="Authentication failed: invalid Bearer token")
+        # Enforce authenticated identity: caller-controlled impersonation headers are rejected
+        if user_header and user_header != "admin":
+            raise HTTPException(
+                status_code=403,
+                detail="Forbidden: caller-controlled identity impersonation via headers is not permitted",
+            )
+        return "admin"
+
+    # 2. When no server API key is configured, check trusted internal middleware state
+    req_state_user = getattr(getattr(request, "state", None), "authenticated_user", None)
+    if req_state_user:
+        return str(req_state_user)
+
+    # 3. Disallow unauthenticated callers from establishing identity via arbitrary headers or tokens
+    if auth_header:
+        raise HTTPException(
+            status_code=401, detail="Authentication rejected: arbitrary Bearer token cannot establish identity"
+        )
+    if user_header:
