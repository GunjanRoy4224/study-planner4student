+def _is_safe_navigation_url(url: str) -> tuple[bool, str]:
+    """Validate a navigation destination URL for autonomous access.
+
+    Enforces:
+    1. Scheme must strictly be http or https (blocks javascript:, data:, file:, etc.).
+    2. Hostname must pass structural SSRF checks.
+    3. Resolves destination hostname via DNS and validates that the resolved IP
+       is public and not private, loopback, link-local, or cloud metadata.
+    """
+    if not url or url.startswith("javascript:") or url.startswith("data:") or url.startswith("vbscript:"):
+        return False, f"Unsafe URL scheme or script handler: {url!r}"
+    try:
+        parsed = urlparse(url)
+    except Exception:
+        return False, f"Cannot parse URL: {url!r}"
+    scheme = (parsed.scheme or "").lower()
+    if scheme not in ("http", "https"):
+        return False, f"Non-HTTP/HTTPS URL scheme '{scheme}' rejected"
+
+    from openjarvis.security.ssrf import check_ssrf, validate_and_resolve_url
+    err = check_ssrf(url)
+    if err:
+        return False, f"SSRF/private destination blocked: {err}"
+
+    try:
+        c_host, val_ip, c_port = validate_and_resolve_url(url)
+    except Exception as exc:
+        return False, f"SSRF destination DNS resolution failed / blocked: {exc}"
+
+    return True, f"safe public HTTP/HTTPS destination (ip={val_ip})"
