+                    decision=PolicyDecision.ALLOW,
+                    reason="Safe public link navigation",
+                    risk_category=RiskCategory.LOW.value,
+                    required_capabilities=req_caps,
+                    target_resource=target_resource,
+                    action_description=action_desc,
+                    redacted_summary=redacted,
+                    action_payload_hash=payload_hash,
+                )
+
+        # 2e. Public Search Input Typing
+        if tool_id == "browser_type":
+            is_search_field = params.get("_is_search_input", False)
+            if is_search_field:
+                return PolicyResult(
+                    decision=PolicyDecision.ALLOW,
+                    reason="Public search input typing",
+                    risk_category=RiskCategory.LOW.value,
+                    required_capabilities=req_caps,
+                    target_resource=target_resource,
+                    action_description=action_desc,
+                    redacted_summary=redacted,
+                    action_payload_hash=payload_hash,
+                )
+
+        # 2f. Explicitly Allowlisted Read-Only MCP Tool
+        if tool_id == "mcp_adapter":
+            from openjarvis.tools.mcp_adapter import is_mcp_tool_safe_readonly
+            server_id = getattr(canonical_tool, "_server_id", None)
+            is_safe_mcp = is_mcp_tool_safe_readonly(
+                canonical_tool.spec,
+                server_id=server_id,
+                trusted_tools=ctx.trusted_mcp_tools,
+                trusted_servers=ctx.trusted_mcp_servers,
+            )
+            if is_safe_mcp:
+                return PolicyResult(
+                    decision=PolicyDecision.ALLOW,
+                    reason=f"Explicitly trusted read-only MCP tool '{canonical_tool.spec.name}'",
+                    risk_category=RiskCategory.LOW.value,
+                    required_capabilities=req_caps,
+                    target_resource=target_resource,
+                    action_description=action_desc,
+                    redacted_summary=redacted,
+                    action_payload_hash=payload_hash,
+                )
+
+        # 2g. Windows Security Diagnostics (read-only diagnostics)
+        if tool_id == "windows_security_diagnostics":
+            diag_action = str(params.get("action", "full_diagnostics")).lower().strip()
+            if diag_action != "remediate":
+                return PolicyResult(
+                    decision=PolicyDecision.ALLOW,
+                    reason=f"Safe read-only Windows security diagnostic ({diag_action})",
+                    risk_category=RiskCategory.LOW.value,
+                    required_capabilities=req_caps,
+                    target_resource=target_resource,
+                    action_description=action_desc,
+                    redacted_summary=redacted,
+                    action_payload_hash=payload_hash,
+                )
+
+        # 2h. Safe unclassified tools without confirmation requirement or consequential capabilities
+        if not getattr(tool.spec, "requires_confirmation", False):
+            consequential_caps = {"code:execute", "fs:write", "browser:interact", "network:outbound"}
+            if not any(c in consequential_caps for c in req_caps):
+                return PolicyResult(
+                    decision=PolicyDecision.ALLOW,
+                    reason=f"Safe tool '{tool_id}' without confirmation requirement",
+                    risk_category=RiskCategory.LOW.value,
+                    required_capabilities=req_caps,
+                    target_resource=target_resource,
+                    action_description=action_desc,
+                    redacted_summary=redacted,
