+        self.db_path = Path(self.tmp_dir) / "audit_lifecycle.db"
+        self.bus = EventBus()
+        self.logger = AuditLogger(db_path=self.db_path, bus=self.bus)
+
+    def tearDown(self):
+        self.logger.close()
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def test_merkle_chain_integrity(self):
+        self.bus.publish(EventType.TOOL_CALL_START, {"tool": "calculator", "arguments": {"expr": "1+1"}})
+        self.bus.publish(EventType.TOOL_CALL_END, {"tool": "calculator", "success": True})
+        self.bus.publish("approval_requested", {"action_id": "act-1", "tool_name": "file_write", "reason": "mutate"})
+        self.bus.publish("approval_decision", {"action_id": "act-1", "status": "approved", "decided_by": "user"})
+
+        events = self.logger.query()
+        self.assertGreaterEqual(len(events), 4)
+
+        # Verify Merkle hash chain across entries
+        valid, invalid_idx = self.logger.verify_integrity()
+        self.assertTrue(valid, f"Merkle hash chain must be strictly valid (failed at index {invalid_idx})")
