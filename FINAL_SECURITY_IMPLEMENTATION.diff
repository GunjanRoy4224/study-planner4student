+
+    def _sanitize_params(self, params: Dict[str, Any], tool_id: str = "") -> Dict[str, Any]:
+        """Produce a redacted parameter dict hiding passwords, tokens, keys, and sensitive free-form values."""
+        import re
+
+        sanitized: Dict[str, Any] = {}
+        _SECRET_KEYS = frozenset(
+            {"password", "passwd", "token", "secret", "key", "api_key", "credential", "auth"}
+        )
+        secret_value_re = re.compile(
+            r"(?:bearer\s+[a-zA-Z0-9_\-\.]{10,}|sk-[a-zA-Z0-9_\-]{20,}|gh[pousr]_[a-zA-Z0-9_]{20,}|xox[baprs]-[a-zA-Z0-9\-]+|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]+PRIVATE KEY-----)",
+            re.IGNORECASE,
+        )
+        for k, v in params.items():
+            if str(k).startswith("_"):
