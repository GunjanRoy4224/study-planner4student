+    def test_policy_engine_enforcement(self):
+        engine = PolicyEngine()
+        ctx = TaskContext(agent_id="test_agent")
+
+        # Read-only diagnostics -> Autonomous ALLOW
+        read_res = engine.evaluate(
+            tool=self.tool,
+            params={"action": "full_diagnostics"},
+            context=ctx,
+        )
+        self.assertEqual(read_res.decision, PolicyDecision.ALLOW)
+
+        def_res = engine.evaluate(
+            tool=self.tool,
+            params={"action": "defender_status"},
+            context=ctx,
+        )
+        self.assertEqual(def_res.decision, PolicyDecision.ALLOW)
+
+        # Remediation -> REQUIRE_APPROVAL
+        rem_res = engine.evaluate(
+            tool=self.tool,
+            params={"action": "remediate", "remediation_action": "update_signatures"},
+            context=ctx,
+        )
+        self.assertEqual(rem_res.decision, PolicyDecision.REQUIRE_APPROVAL)
+        self.assertIn("remediation", rem_res.reason.lower())
