+"""Centralized Policy Enforcement Point (PEP) for OpenJarvis.
+
+Enforces fine-grained authorization, security boundaries, and approval requirements
+across all tool dispatch paths (CLI, HTTP API, SSE streaming, AgentManager,
+TaskScheduler, and subagents).
+
+Every tool call must pass through PolicyEngine before execution.
+Decisions:
+- ALLOW: Action is safe and permitted autonomously.
+- REQUIRE_APPROVAL: Action is potentially consequential, mutating, or sensitive.
+  Execution must be suspended until explicit human approval is received.
+- DENY: Action violates a fundamental security boundary (SSRF, sensitive credentials,
+  path traversal outside workspace, unisolated execution).
+  Human approval cannot override a DENY decision.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import os
+import re
+from dataclasses import dataclass, field
+from enum import Enum
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Set
+
+from openjarvis.security.capabilities import (
+    Capability,
+    CapabilityPolicy,
+    canonical_tool_capabilities,
+)
+from openjarvis.security.file_policy import is_sensitive_file
+from openjarvis.security.ssrf import check_ssrf
+from openjarvis.tools._stubs import BaseTool, ToolResult, ToolSpec
+
+logger = logging.getLogger(__name__)
+
+
+class PolicyDecision(str, Enum):
+    """Authoritative decisions rendered by PolicyEngine."""
+
+    ALLOW = "ALLOW"
+    REQUIRE_APPROVAL = "REQUIRE_APPROVAL"
+    DENY = "DENY"
+
+
+class RiskCategory(str, Enum):
+    """Risk tier for operations requiring approval or auditing."""
+
+    TRIVIAL = "trivial"
+    LOW = "low"
+    MEDIUM = "medium"
+    HIGH = "high"
+    CRITICAL = "critical"
+
+
+@dataclass
+class PolicyResult:
+    """The outcome of a policy evaluation."""
+
+    decision: PolicyDecision
+    reason: str = ""
+    risk_category: str = RiskCategory.MEDIUM.value
+    required_capabilities: List[str] = field(default_factory=list)
+    target_resource: str = ""
+    action_description: str = ""
+    redacted_summary: Dict[str, Any] = field(default_factory=dict)
+    action_payload_hash: str = ""
+
+    @property
+    def is_allowed(self) -> bool:
+        return self.decision == PolicyDecision.ALLOW
+
+    @property
+    def requires_approval(self) -> bool:
+        return self.decision == PolicyDecision.REQUIRE_APPROVAL
+
+    @property
+    def is_denied(self) -> bool:
+        return self.decision == PolicyDecision.DENY
+
+
+@dataclass
+class TaskContext:
+    """Context governing execution of a user turn or background task."""
+
+    agent_id: str = "primary"
+    task_id: str = ""
+    task_scope: str = ""
+    is_interactive: bool = False
+    is_background: bool = False
+    allowed_tools: Optional[List[str]] = None
+    allowed_dirs: Optional[List[str]] = None
+    trusted_mcp_servers: Optional[Set[str]] = None
+    trusted_mcp_tools: Optional[Set[str]] = None
+    session_taint: Optional[Any] = None
+    capability_policy: Optional[CapabilityPolicy] = None
+    rate_limiter: Optional[Any] = None
+    boundary_guard: Optional[Any] = None
+
+
+def compute_action_payload_hash(
+    tool_name: str,
+    target: Any = "",
+    params: Optional[Dict[str, Any]] = None,
+) -> str:
+    """Compute a deterministic SHA-256 hash over an authorized action payload.
+
+    Ensures that an approval cannot be replayed for different parameters or targets.
+    Accepts both (tool_name, params) and (tool_name, target, params).
+    """
+    if params is None and isinstance(target, dict):
+        actual_params = target
+        actual_target = ""
+    else:
+        actual_params = params or {}
+        actual_target = str(target or "")
+
+    try:
+        # Filter internal metadata keys such as _taint
+        clean_params = {k: v for k, v in actual_params.items() if not str(k).startswith("_")}
+        canonical_json = json.dumps(clean_params, sort_keys=True, separators=(",", ":"))
+    except Exception:
+        clean_params = {k: str(v) for k, v in actual_params.items() if not str(k).startswith("_")}
+        canonical_json = json.dumps(clean_params, sort_keys=True, separators=(",", ":"))
+
+    hash_input = f"{str(tool_name).strip().lower()}:{actual_target.strip()}:{canonical_json}"
+    return hashlib.sha256(hash_input.encode("utf-8")).hexdigest()
+
+
+class PolicyEngine:
+    """Central authoritative security policy engine for tool execution."""
+
+    def __init__(
+        self,
+        capability_policy: Optional[CapabilityPolicy] = None,
+        *,
+        default_workspace_dirs: Optional[List[str]] = None,
+    ) -> None:
+        self._capability_policy = capability_policy
+        self._default_workspace_dirs = default_workspace_dirs
+
+    def unwrap_tool(self, tool: Any) -> tuple[Any, str]:
+        """Traverse delegating wrappers to extract canonical tool and tool identity."""
+        if isinstance(tool, str):
+            return tool, tool.lower().strip()
+        target = tool
+        seen = set()
+        while hasattr(target, "_wrapped") and id(target) not in seen:
+            seen.add(id(target))
+            target = target._wrapped
+
+        tool_id = (
+            getattr(target, "tool_id", None)
+            or getattr(getattr(target, "spec", None), "name", None)
+            or getattr(tool, "tool_id", None)
+            or getattr(getattr(tool, "spec", None), "name", None)
+            or str(tool)
+        )
+        return target, str(tool_id).lower().strip()
+
+    def evaluate(
+        self,
+        tool: BaseTool,
+        params: Dict[str, Any],
+        context: Optional[TaskContext] = None,
+    ) -> PolicyResult:
+        """Evaluate a tool invocation request against the full security matrix.
+
+        Returns PolicyResult(ALLOW, REQUIRE_APPROVAL, or DENY).
+        """
+        ctx = context or TaskContext()
+        canonical_tool, tool_id = self.unwrap_tool(tool)
+
+        # Extract target resource and human-readable description
+        target_resource = ""
+        action_desc = ""
+
+        if tool_id in ("file_read", "file_write", "apply_patch", "browser_screenshot"):
+            raw_path = params.get("path", "")
+            target_resource = str(raw_path) if raw_path else ""
+            if tool_id == "file_read":
+                action_desc = f"Read file {target_resource}"
+            elif tool_id == "file_write":
+                mode = params.get("mode", "write")
+                action_desc = f"{mode.capitalize()} file {target_resource}"
+            elif tool_id == "browser_screenshot":
+                action_desc = f"Save screenshot to file {target_resource}" if target_resource else "Capture browser screenshot"
+            else:
+                action_desc = f"Apply patch to file {target_resource}"
+
+        elif tool_id in ("http_request", "browser_navigate"):
+            raw_url = params.get("url", "")
+            target_resource = str(raw_url) if raw_url else ""
+            action_desc = f"Navigate/request URL {target_resource}"
+
+        elif tool_id == "browser_click":
+            raw_sel = params.get("selector") or params.get("target") or params.get("text") or ""
+            target_resource = str(raw_sel)
+            action_desc = f"Click element '{target_resource}'"
+
+        elif tool_id == "browser_type":
+            raw_sel = params.get("selector") or params.get("target") or "input"
+            target_resource = str(raw_sel)
+            action_desc = f"Type into element '{target_resource}'"
+
+        elif tool_id in ("shell_exec", "docker_shell_exec"):
+            cmd = str(params.get("command", "")).strip()
+            target_resource = cmd[:120]
+            action_desc = f"Execute shell command: {cmd[:80]}"
+
+        elif tool_id in ("code_interpreter", "code_interpreter_docker"):
+            code = str(params.get("code", "")).strip()
+            target_resource = code[:120]
+            action_desc = "Execute Python code in isolated sandbox"
+
+        elif tool_id == "windows_security_diagnostics":
+            act = str(params.get("action", "full_diagnostics")).strip()
+            target_resource = f"windows_security:{act}"
+            action_desc = f"Windows security diagnostic: {act}"
+
+        elif tool_id == "mcp_adapter":
+            mcp_name = getattr(canonical_tool.spec, "name", "mcp_tool")
+            target_resource = f"mcp:{mcp_name}"
+            action_desc = f"Invoke external MCP tool '{mcp_name}'"
+
+        else:
+            target_resource = tool_id
+            action_desc = f"Invoke tool '{tool_id}'"
+
+        # Compute payload hash
+        payload_hash = compute_action_payload_hash(tool_id, target_resource, params)
+
+        # Redacted parameter summary (strip passwords/tokens/free-form inputs)
+        redacted = self._sanitize_params(params, tool_id=tool_id)
+
+        # Determine effective required capabilities
+        raw_req_caps = canonical_tool_capabilities(canonical_tool)
+        req_caps = [c.value if hasattr(c, "value") else str(c) for c in raw_req_caps]
+        tool_spec = getattr(tool, "spec", None)
+        wrapper_caps = list(getattr(tool_spec, "required_capabilities", []) or []) if tool_spec else []
+        for c in wrapper_caps:
+            c_val = c.value if hasattr(c, "value") else str(c)
+            if c_val not in req_caps:
+                req_caps.append(c_val)
+
+        # =====================================================================
+        # 1. ABSOLUTE DENY RULES (Human approval CANNOT override)
+        # =====================================================================
+
+        # 1a. Prohibited Network / SSRF Destinations
+        if target_resource and (tool_id in ("http_request", "browser_navigate") or target_resource.startswith(("http://", "https://"))):
+            ssrf_err = check_ssrf(target_resource)
+            if ssrf_err:
+                return PolicyResult(
+                    decision=PolicyDecision.DENY,
+                    reason=f"SSRF blocked: {ssrf_err}",
+                    risk_category=RiskCategory.CRITICAL.value,
+                    required_capabilities=req_caps,
+                    target_resource=target_resource,
+                    action_description=action_desc,
+                    redacted_summary=redacted,
+                    action_payload_hash=payload_hash,
+                )
+
+        # 1b. Sensitive Credential and Key Files
+        if target_resource and tool_id in ("file_read", "file_write", "apply_patch", "browser_screenshot"):
+            try:
+                p = Path(target_resource)
+                if is_sensitive_file(p):
+                    return PolicyResult(
+                        decision=PolicyDecision.DENY,
+                        reason=f"Access denied: '{target_resource}' is a restricted sensitive credential/key file.",
+                        risk_category=RiskCategory.CRITICAL.value,
+                        required_capabilities=req_caps,
+                        target_resource=target_resource,
+                        action_description=action_desc,
+                        redacted_summary=redacted,
+                        action_payload_hash=payload_hash,
+                    )
+            except Exception as exc:
+                logger.debug("Error checking sensitive file: %s", exc)
+
+        # 1c. Filesystem Workspace Boundaries
+        if target_resource and tool_id in ("file_read", "file_write", "apply_patch", "browser_screenshot"):
+            allowed_dirs = ctx.allowed_dirs or self._default_workspace_dirs
+            if allowed_dirs:
+                allowed_paths = [Path(d).expanduser().resolve() for d in allowed_dirs]
+                target_p = Path(target_resource)
+                if not target_p.is_absolute():
+                    target_p = (allowed_paths[0] / target_p)
+                resolved_target = target_p.resolve()
+                if not any(resolved_target == d or resolved_target.is_relative_to(d) for d in allowed_paths):
+                    return PolicyResult(
+                        decision=PolicyDecision.DENY,
+                        reason=f"Access denied: '{target_resource}' is outside authorized workspace directories.",
+                        risk_category=RiskCategory.CRITICAL.value,
+                        required_capabilities=req_caps,
+                        target_resource=target_resource,
+                        action_description=action_desc,
+                        redacted_summary=redacted,
+                        action_payload_hash=payload_hash,
+                    )
+
+        # 1d. Task Scope Tools Restriction
+        if ctx.allowed_tools is not None:
+            if tool_id not in ctx.allowed_tools and tool.spec.name not in ctx.allowed_tools:
+                return PolicyResult(
+                    decision=PolicyDecision.DENY,
+                    reason=f"Tool '{tool_id}' is not permitted within task scope.",
+                    risk_category=RiskCategory.HIGH.value,
+                    required_capabilities=req_caps,
+                    target_resource=target_resource,
+                    action_description=action_desc,
+                    redacted_summary=redacted,
+                    action_payload_hash=payload_hash,
+                )
+
+        # 1e. Capability Policy Checks (RBAC)
+        cap_policy = ctx.capability_policy or self._capability_policy
+        if cap_policy is not None:
+            for cap in req_caps:
+                if not cap_policy.check(ctx.agent_id, cap, tool_id):
+                    return PolicyResult(
+                        decision=PolicyDecision.DENY,
+                        reason=f"Capability '{cap}' denied for agent '{ctx.agent_id}' on tool '{tool_id}'.",
+                        risk_category=RiskCategory.HIGH.value,
+                        required_capabilities=req_caps,
+                        target_resource=target_resource,
+                        action_description=action_desc,
+                        redacted_summary=redacted,
+                        action_payload_hash=payload_hash,
+                    )
+
+        # =====================================================================
+        # 2. AUTONOMOUS ALLOW RULES
+        # =====================================================================
+
+        # 2a. Calculator and Local Computations
+        if tool_id in ("calculator", "think"):
+            return PolicyResult(
+                decision=PolicyDecision.ALLOW,
+                reason="Safe local computation",
+                risk_category=RiskCategory.TRIVIAL.value,
+                required_capabilities=req_caps,
+                target_resource=target_resource,
+                action_description=action_desc,
+                redacted_summary=redacted,
+                action_payload_hash=payload_hash,
+            )
+
+        # 2b. Non-sensitive File Reading in Authorized Workspace
+        if tool_id == "file_read":
+            return PolicyResult(
+                decision=PolicyDecision.ALLOW,
+                reason="Safe workspace file read",
+                risk_category=RiskCategory.LOW.value,
+                required_capabilities=req_caps,
+                target_resource=target_resource,
+                action_description=action_desc,
+                redacted_summary=redacted,
+                action_payload_hash=payload_hash,
+            )
+
+        # 2b-2. In-memory Browser Screenshot (no disk write)
+        if tool_id == "browser_screenshot" and not target_resource:
+            return PolicyResult(
+                decision=PolicyDecision.ALLOW,
+                reason="Safe in-memory page screenshot",
+                risk_category=RiskCategory.LOW.value,
+                required_capabilities=req_caps,
+                target_resource=target_resource,
+                action_description=action_desc,
+                redacted_summary=redacted,
+                action_payload_hash=payload_hash,
+            )
+
+        # 2c. Public Browser Navigation
+        if tool_id == "browser_navigate":
+            return PolicyResult(
+                decision=PolicyDecision.ALLOW,
+                reason="Validated public web navigation",
+                risk_category=RiskCategory.LOW.value,
+                required_capabilities=req_caps,
+                target_resource=target_resource,
+                action_description=action_desc,
+                redacted_summary=redacted,
+                action_payload_hash=payload_hash,
+            )
+
+        # 2d. Safe Browser Click / Safe Disclosure Tabs
+        if tool_id == "browser_click":
+            # If the action has been pre-inspected and tagged as a safe navigation link
+            is_safe_nav = params.get("_safe_navigation_link", False)
+            if is_safe_nav:
