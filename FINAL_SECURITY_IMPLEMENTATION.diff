+# ===========================================================================
+# 11. Streaming Redaction Across Chunk Boundaries
+# ===========================================================================
+
+
+class MockStreamEngine(InferenceEngine):
+    def __init__(self, token_chunks: list[str]) -> None:
+        self._chunks = token_chunks
+
+    @property
+    def engine_id(self) -> str:
+        return "mock_stream"
+
+    async def generate(self, messages, **kwargs):
+        return {"content": "".join(self._chunks)}
+
+    async def stream(self, messages, **kwargs):
+        for c in self._chunks:
+            yield c
+
+    async def stream_full(self, messages, **kwargs):
+        for idx, c in enumerate(self._chunks):
+            yield StreamChunk(
+                content=c,
+                finish_reason="stop" if idx == len(self._chunks) - 1 else None,
+            )
+
+    def health(self):
+        return True
+
+    def list_models(self):
+        return ["mock"]
+
+
+class TestStreamingRedactionAcrossChunkBoundaries(unittest.IsolatedAsyncioTestCase):
+    async def test_stream_redacts_split_secrets(self):
+        secret = "ghp_1234567890abcdef1234567890abcdef1234"
+        part1 = secret[:10]
+        part2 = secret[10:]
+        raw_engine = MockStreamEngine([f"Here is your token: {part1}", f"{part2} please keep safe."])
+        guardrails = GuardrailsEngine(raw_engine, mode=RedactionMode.REDACT)
+
+        tokens = []
+        async for token in guardrails.stream([Message(role="user", content="give token")], model="mock"):
+            tokens.append(token)
+
+        full_output = "".join(tokens)
+        self.assertNotIn(secret, full_output)
+        self.assertIn("[REDACTED:github_token]", full_output)
+
+    async def test_stream_full_redacts_split_secrets_without_leaking_fragments(self):
+        secret = "ghp_1234567890abcdef1234567890abcdef1234"
+        part1 = secret[:12]
+        part2 = secret[12:]
+        raw_engine = MockStreamEngine([f"Key: {part1}", f"{part2} end."])
+        guardrails = GuardrailsEngine(raw_engine, mode=RedactionMode.REDACT)
+
+        chunks: list[StreamChunk] = []
+        async for chunk in guardrails.stream_full([Message(role="user", content="give token")], model="mock"):
+            chunks.append(chunk)
+
+        full_content = "".join(c.content for c in chunks)
+        self.assertNotIn(secret, full_content)
+        self.assertNotIn(part2, full_content)
+        self.assertIn("[REDACTED:github_token]", full_content)
+        self.assertEqual(chunks[-1].finish_reason, "stop")
+
+    async def test_stream_full_blocks_on_secret(self):
+        secret = "ghp_1234567890abcdef1234567890abcdef1234"
+        raw_engine = MockStreamEngine(["Token: ", secret])
+        guardrails = GuardrailsEngine(raw_engine, mode=RedactionMode.BLOCK)
+
+        with self.assertRaises(SecurityBlockError):
+            async for _ in guardrails.stream_full([Message(role="user", content="give token")], model="mock"):
+                pass
