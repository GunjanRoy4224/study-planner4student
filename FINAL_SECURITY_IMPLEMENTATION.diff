+class TestFileModificationApproval(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+        self.tmp_path = Path(self.tmp_dir)
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def test_file_write_spec_requires_confirmation(self):
+        tool = FileWriteTool(allowed_dirs=[str(self.tmp_path)])
+        self.assertTrue(tool.spec.requires_confirmation)
+
+    def test_apply_patch_spec_requires_confirmation(self):
+        tool = ApplyPatchTool(allowed_dirs=[str(self.tmp_path)])
+        self.assertTrue(tool.spec.requires_confirmation)
+
+    def test_executor_denies_file_write_without_confirmation_callback(self):
+        target = self.tmp_path / "test.txt"
+        tool = FileWriteTool(allowed_dirs=[str(self.tmp_path)])
+        executor = ToolExecutor([tool], interactive=False, confirm_callback=None)
+
+        call = ToolCall("c1", "file_write", f'{{"path": "{target.as_posix()}", "content": "hello"}}')
+        res = executor.execute(call)
+
+        self.assertFalse(res.success)
+        self.assertIn("requires confirmation", res.content)
+        self.assertFalse(target.exists())
+
+    def test_executor_denies_file_write_when_user_rejects(self):
+        target = self.tmp_path / "test.txt"
+        tool = FileWriteTool(allowed_dirs=[str(self.tmp_path)])
+        executor = ToolExecutor([tool], interactive=True, confirm_callback=lambda prompt: False)
+
+        call = ToolCall("c2", "file_write", f'{{"path": "{target.as_posix()}", "content": "hello"}}')
+        res = executor.execute(call)
+
+        self.assertFalse(res.success)
+        self.assertIn("denied by user", res.content)
+        self.assertFalse(target.exists())
+
+    def test_executor_permits_file_write_when_user_approves_new_file(self):
+        target = self.tmp_path / "new_file.txt"
+        tool = FileWriteTool(allowed_dirs=[str(self.tmp_path)])
+        executor = ToolExecutor([tool], interactive=True, confirm_callback=lambda prompt: True)
+
+        call = ToolCall("c3", "file_write", f'{{"path": "{target.as_posix()}", "content": "fresh data"}}')
+        res = executor.execute(call)
+
+        self.assertTrue(res.success)
