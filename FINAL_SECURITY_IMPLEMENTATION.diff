+        db_path = self.tmp_path / "approvals_test.db"
+        store = ApprovalStore(db_path=str(db_path))
+
+        # Store an expired rule (ttl_days=-1 means expired yesterday)
+        store.set_permission("delete_file:test", "always_approve", ttl_days=-1)
+
+        # get_permission should detect expiration, clear it, and return None
+        rule = store.get_permission("delete_file:test")
+        self.assertIsNone(rule)
+
+        # Store an active rule
+        store.set_permission("safe_read:test", "always_approve", ttl_days=7)
+        active_rule = store.get_permission("safe_read:test")
+        self.assertIsNotNone(active_rule)
+        self.assertEqual(active_rule.permission_key, "safe_read:test")
+        self.assertNotEqual(active_rule.expires_at, "")
+
+        # list_permissions should only return active rules
+        rules = store.list_permissions()
+        self.assertEqual(len(rules), 1)
+        self.assertEqual(rules[0].permission_key, "safe_read:test")
