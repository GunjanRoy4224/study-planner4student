+"""Tests for WindowsSecurityDiagnosticsTool and policy engine integration."""
+
+from __future__ import annotations
+
+import json
+import unittest
+from unittest.mock import MagicMock, patch
+
+from openjarvis.core.registry import ToolRegistry
+from openjarvis.security.policy_engine import PolicyDecision, PolicyEngine, TaskContext
+from openjarvis.tools.windows_security_diagnostics import (
+    WindowsSecurityDiagnosticsTool,
+    _run_powershell,
+)
+
+
+class TestWindowsSecurityDiagnostics(unittest.TestCase):
+    def setUp(self):
+        self.tool = WindowsSecurityDiagnosticsTool()
+
+    def test_registration_and_spec(self):
+        registered = ToolRegistry.get("windows_security_diagnostics")
+        self.assertIsNotNone(registered)
+        spec = self.tool.spec
+        self.assertEqual(spec.name, "windows_security_diagnostics")
+        self.assertEqual(spec.category, "system")
+        self.assertIn("action", spec.parameters["properties"])
+        self.assertIn("system:diagnostics", spec.required_capabilities)
+
+    @patch("openjarvis.tools.windows_security_diagnostics._run_powershell")
+    @patch("os.name", "nt")
+    def test_defender_status(self, mock_ps):
+        status_json = json.dumps(
+            {
+                "AntivirusEnabled": True,
+                "RealTimeProtectionEnabled": True,
+                "AntivirusSignatureAge": 1,
+                "BehaviorMonitorEnabled": True,
+                "IoavProtectionEnabled": True,
