+def make_secure_container_inspect(overrides=None):
+    base = {
+        "Id": "a1b2c3d4e5f60123456789abcdef0123456789abcdef0123456789abcdef0123",
+        "State": {"Running": True},
+        "HostConfig": {
+            "Privileged": False,
+            "NetworkMode": "none",
+            "CapDrop": ["ALL"],
+            "CapAdd": [],
+            "SecurityOpt": ["no-new-privileges:true"],
+            "Memory": 536870912,
+            "CpuQuota": 50000,
+            "NanoCpus": 0,
+            "PidsLimit": 100,
+            "ReadonlyRootfs": True,
+        },
+        "Config": {"User": "appuser"},
+        "Mounts": [],
+    }
+    if overrides:
+        for k, v in overrides.items():
+            if isinstance(v, dict) and k in base and isinstance(base[k], dict):
+                base[k] = {**base[k], **v}
+            else:
+                base[k] = v
+    return base
+
+
