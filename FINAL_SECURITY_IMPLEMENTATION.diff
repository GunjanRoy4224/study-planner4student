+"""Regression tests verifying policy propagation to ApplyPatchTool across all runtime paths."""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+from click.testing import CliRunner
+
+from openjarvis.core.config import JarvisConfig
+from openjarvis.core.registry import ToolRegistry
+import openjarvis.tools.apply_patch
+from openjarvis.tools.apply_patch import ApplyPatchTool
+
+
+class TestApplyPatchPolicyPropagation(unittest.TestCase):
+    """Prove that security.allowed_dirs is propagated to ApplyPatchTool across all runtime paths."""
+
+    def setUp(self):
+        import os
+        self.tmp_dir = tempfile.mkdtemp()
+        self.tmp_path = Path(self.tmp_dir)
+        self._orig_home = os.environ.get("OPENJARVIS_HOME")
+        self._orig_config_dir = os.environ.get("OPENJARVIS_CONFIG_DIR")
+        os.environ["OPENJARVIS_HOME"] = self.tmp_dir
+        os.environ["OPENJARVIS_CONFIG_DIR"] = self.tmp_dir
+        if not ToolRegistry.contains("apply_patch"):
+            ToolRegistry.register_value("apply_patch", ApplyPatchTool)
