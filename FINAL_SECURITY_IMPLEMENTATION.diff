+    def test_executor_denies_apply_patch_without_confirmation(self):
+        target = self.tmp_path / "patched.txt"
+        target.write_text("line 1\nline 2\n", encoding="utf-8")
+        patch_content = (
+            f"--- a/{target.name}\n"
+            f"+++ b/{target.name}\n"
+            "@@ -1,2 +1,2 @@\n"
+            " line 1\n"
+            "-line 2\n"
+            "+line 2 modified\n"
+        )
+        tool = ApplyPatchTool(allowed_dirs=[str(self.tmp_path)])
+        executor = ToolExecutor([tool], interactive=False, confirm_callback=None)
+
+        call_args = json.dumps({"patch": patch_content, "path": target.as_posix()})
+        call = ToolCall("c6", "apply_patch", call_args)
+        res = executor.execute(call)
+
+        self.assertFalse(res.success)
+        self.assertIn("requires confirmation", res.content)
+        self.assertNotIn("line 2 modified", target.read_text(encoding="utf-8"))
