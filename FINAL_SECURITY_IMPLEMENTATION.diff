+    def test_executor_requires_approval_when_overwriting_existing_file(self):
+        target = self.tmp_path / "existing.txt"
+        target.write_text("initial", encoding="utf-8")
+
+        tool = FileWriteTool(allowed_dirs=[str(self.tmp_path)])
+        # Denied attempt
+        executor_denying = ToolExecutor([tool], interactive=True, confirm_callback=lambda prompt: False)
+        call_deny = ToolCall("c4", "file_write", f'{{"path": "{target.as_posix()}", "content": "overwrite"}}')
+        res_deny = executor_denying.execute(call_deny)
+        self.assertFalse(res_deny.success)
+        self.assertEqual(target.read_text(encoding="utf-8"), "initial")
+
+        # Approved attempt
