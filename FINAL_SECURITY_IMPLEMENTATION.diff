+    def test_repeated_modifications_create_unique_backups_without_overwriting(self):
+        """Repeated patches must never silently overwrite previous backups."""
+        target = self.tmp_path / "versioned.txt"
+        target.write_text("version 1\n", encoding="utf-8")
+
+        tool = ApplyPatchTool(allowed_dirs=[str(self.tmp_path)])
+
+        # Patch 1: v1 -> v2
+        p1 = f"--- a/{target.name}\n+++ b/{target.name}\n@@ -1 +1 @@\n-version 1\n+version 2\n"
+        res1 = tool.execute(patch=p1, path=str(target), backup=True)
+        self.assertTrue(res1.success)
+        bak1_path = Path(res1.metadata["backup_path"])
+        self.assertTrue(bak1_path.exists())
+        self.assertEqual(bak1_path.read_text(encoding="utf-8"), "version 1\n")
+
+        # Patch 2: v2 -> v3
+        p2 = f"--- a/{target.name}\n+++ b/{target.name}\n@@ -1 +1 @@\n-version 2\n+version 3\n"
+        res2 = tool.execute(patch=p2, path=str(target), backup=True)
+        self.assertTrue(res2.success)
+        bak2_path = Path(res2.metadata["backup_path"])
+        self.assertTrue(bak2_path.exists())
+        self.assertEqual(bak2_path.read_text(encoding="utf-8"), "version 2\n")
+
+        # Crucial check: bak1 was NOT overwritten by bak2!
+        self.assertNotEqual(str(bak1_path), str(bak2_path))
+        self.assertEqual(bak1_path.read_text(encoding="utf-8"), "version 1\n")
+        self.assertEqual(bak2_path.read_text(encoding="utf-8"), "version 2\n")
+        self.assertEqual(target.read_text(encoding="utf-8"), "version 3\n")
+
+    def test_patch_preserves_original_file_if_backup_fails(self):
